{
  "name": "strut",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, AI-native motion design studio for interactive product graphics.",
  "license": "Apache-2.0",
  "keywords": [
    "animation",
    "motion-design",
    "vector-graphics",
    "rive-alternative",
    "lottie",
    "tauri",
    "rust",
    "wgpu",
    "webgpu",
    "ai-design",
    "generative-design",
    "local-first",
    "byok",
    "mcp",
    "ollama",
    "openai",
    "anthropic",
    "gemini",
    "openrouter",
    "react",
    "desktop-app"
  ],
  "workspaces": [
    "apps/studio",
    "packages/*"
  ],
  "scripts": {
    "check": "npm run check:ts && npm run check:runtime && cargo check --workspace",
    "check:ts": "npm --workspace @strut/studio run check",
    "check:runtime": "npm --workspace @strut/runtime-web run check",
    "test": "cargo test --workspace",
    "test:ui": "python tests/ui/studio_bot_smoke.py",
    "test:runtime-ui": "python tests/ui/runtime_bot_smoke.py",
    "test:all": "npm run check && npm run test && npm run test:ui && npm run test:runtime-ui",
    "runtime:build": "npm --workspace @strut/runtime-web run build",
    "studio:dev": "npm --workspace @strut/studio run tauri -- dev",
    "studio:build": "npm --workspace @strut/studio run tauri -- build"
  }
}
